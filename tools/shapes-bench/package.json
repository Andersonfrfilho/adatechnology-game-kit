{
  "name": "@adatechnology/shapes-bench-tool",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Timing bench of the kit's 3D builders (props, household, items, weapons, animals, characters, vegetation, urban, houses, light vehicles and the game-shapes generators): medians normalised by a calibration loop, a baseline and a --check that fails on a regression past the budget.",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "node --expose-gc dist/cli.js",
    "bench:check": "node --expose-gc dist/cli.js --check",
    "bench:update": "node --expose-gc dist/cli.js --update"
  },
  "devDependencies": {
    "@adatechnology/game-animals-species": "workspace:*",
    "@adatechnology/game-animals-three": "workspace:*",
    "@adatechnology/game-characters": "workspace:*",
    "@adatechnology/game-characters-three": "workspace:*",
    "@adatechnology/game-characters-undead": "workspace:*",
    "@adatechnology/game-floorplan": "workspace:*",
    "@adatechnology/game-floorplan-commercial": "workspace:*",
    "@adatechnology/game-floorplan-residential": "workspace:*",
    "@adatechnology/game-floorplan-structure": "workspace:*",
    "@adatechnology/game-floorplan-three": "workspace:*",
    "@adatechnology/game-interactables-household": "workspace:*",
    "@adatechnology/game-kit-defaults": "workspace:*",
    "@adatechnology/game-interactables-three": "workspace:*",
    "@adatechnology/game-items-goods": "workspace:*",
    "@adatechnology/game-items-three": "workspace:*",
    "@adatechnology/game-props3d": "workspace:*",
    "@adatechnology/game-shapes": "workspace:*",
    "@adatechnology/game-shapes-three": "workspace:*",
    "@adatechnology/game-urban": "workspace:*",
    "@adatechnology/game-urban-three": "workspace:*",
    "@adatechnology/game-vegetation": "workspace:*",
    "@adatechnology/game-vegetation-species": "workspace:*",
    "@adatechnology/game-vegetation-three": "workspace:*",
    "@adatechnology/game-vehicles": "workspace:*",
    "@adatechnology/game-vehicles-fleet": "workspace:*",
    "@adatechnology/game-vehicles-three": "workspace:*",
    "@adatechnology/game-weapons-three": "workspace:*",
