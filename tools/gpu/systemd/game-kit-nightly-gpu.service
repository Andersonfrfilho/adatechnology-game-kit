# The GPU daily run on main (tools/gpu/nightly-gpu.mjs), under the same GPU lock as the pre-push, at the lowest CPU and IO priority.
# Installed by tools/gpu/systemd/install-nightly.sh, which fills @REPO@ and @NODE_PATH@.
[Unit]
Description=game-kit: GPU daily run on main (browser suites and frame budgets)

[Service]
Type=oneshot
Environment=PATH=@NODE_PATH@:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=@REPO@
ExecStart=/usr/bin/flock %h/.cache/adatechnology-game-kit/gpu.lock node @REPO@/tools/gpu/nightly-gpu.mjs
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=8h
