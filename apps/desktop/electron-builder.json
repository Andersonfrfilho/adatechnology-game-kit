{
  "appId": "com.adatechnology.gamekit.desktop",
  "productName": "AdA Game Kit",
  "directories": { "output": "release", "buildResources": "resources" },
  "files": ["dist/main.cjs", "package.json"],
  "extraResources": [{ "from": "build/room", "to": "room" }],
  "asar": true,
  "linux": { "target": ["AppImage"], "category": "Game", "artifactName": "ada-game-kit-${version}-${arch}.AppImage" },
  "mac": { "target": ["dmg"], "category": "public.app-category.games" },
  "win": { "target": ["nsis"] }
}
