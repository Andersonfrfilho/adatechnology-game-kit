{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "site/Dockerfile",
    "watchPatterns": ["packages/**", "examples/**", "site/**", "pnpm-lock.yaml", "package.json", "railway.json"]
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
