{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "ES2023.Array",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@adatechnology/*/testing": [
        "packages/*/dist/testing.d.ts"
      ],
      "@adatechnology/*": [
        "packages/*/dist/index.d.ts"
      ],
      "three": [
        "node_modules/@types/three/index.d.ts"
      ],
      "playwright": [
        "node_modules/playwright-core/index.d.ts"
      ]
    }
  },
  "include": [
    "./examples/**/*.js",
    "./examples/**/*.mjs",
    "./tools/**/*.js",
    "./tools/**/*.mjs",
    "./types/scripts-globals.d.ts",
    "./site/*.js",
    "./site/*.mjs"
  ],
  "exclude": [
    "./**/node_modules",
    "./**/dist"
  ]
}
