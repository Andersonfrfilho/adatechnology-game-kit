# the kit's own sounds are packages/game-audio/assets/sfx/<categoria>/*.ogg (CC0 and CC-BY, each one in manifest.json and CREDITOS.md); the
# originals the converter reads stay outside (ZombiAdA assets/sfx-originais). Local copies or links, by packages/game-audio/scripts/sfx-dir.mjs:
.sfx/
.sfx-inbox/
# and no other audio file anywhere in the tree (guard-git checks the same in CI and pre-commit)
*.ogg
*.oga
*.wav
*.wave
*.mp3
*.flac
*.m4a
*.aif
*.aiff
*.opus
!packages/game-audio/assets/sfx/*/*.ogg

# the owner's own sounds (packs the kit cannot redistribute), converted by `pnpm --filter @adatechnology/game-audio sfx:user`: local only
.sfx-local/
.sfx-local.json
# Local audio configuration and raw storage (never committed)
*.audio.local.json
audio.config.local.json
audio.local.json
/local-audio/
tools/audio-pipeline/storage/
tools/audio-pipeline/*.local.*
