{
  "name": "adatechnology-game-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Engine-agnostic game building blocks (camera, devtools, infection model, procedural props) published under @adatechnology/",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "check:items": "pnpm --filter \"@adatechnology/game-items-goods...\" build && node packages/game-items-goods/scripts/check-items.mjs",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist",
    "changeset": "changeset",
    "version:changeset": "changeset version",
    "publish:changesets": "pnpm build && changeset publish",
    "site:dev": "docker compose -p adatechnology-game-kit watch",
    "site:thumbs": "node site/capture-thumbs.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check:layers": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json packages/*/src",
    "check:layers:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json packages/*/src",
    "check:packages": "node tools/check-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.18.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.18.0",
    "globals": "^16.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
