{
  "name": "adatechnology-game-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Engine-agnostic game building blocks (camera, devtools, infection model, procedural props) published under @adatechnology/",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "check:items": "pnpm --filter \"@adatechnology/game-items-goods...\" build && node packages/game-items-goods/scripts/check-items.mjs",
    "check:area": "node tools/check-area/check-area.mjs",
    "check:animals": "node tools/check-area/check-area.mjs animals",
    "check:audio": "node tools/check-area/check-area.mjs audio",
    "check:characters": "node tools/check-area/check-area.mjs characters",
    "check:crowd": "node tools/check-area/check-area.mjs crowd",
    "check:floorplan": "node tools/check-area/check-area.mjs floorplan",
    "check:interactables": "node tools/check-area/check-area.mjs interactables",
    "check:items-area": "node tools/check-area/check-area.mjs items-area",
    "check:player": "node tools/check-area/check-area.mjs player",
    "check:room": "node tools/check-area/check-area.mjs room",
    "check:showroom": "node tools/check-area/check-area.mjs showroom",
    "check:stories": "node tools/check-area/check-area.mjs stories",
    "check:urban": "node tools/check-area/check-area.mjs urban",
    "check:vegetation": "node tools/check-area/check-area.mjs vegetation",
    "check:vehicles": "node tools/check-area/check-area.mjs vehicles",
    "check:vehicles-proving": "node tools/check-area/check-area.mjs vehicles-proving",
    "check:vfx": "node tools/check-area/check-area.mjs vfx",
    "check:weapons": "node tools/check-area/check-area.mjs weapons",
    "check:weather": "node tools/check-area/check-area.mjs weather",
    "test:check-area": "node --test tools/check-area/tests/*.test.mjs",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist",
    "changeset": "changeset",
    "version:changeset": "changeset version",
    "publish:changesets": "pnpm build && changeset publish",
    "site:dev": "docker compose -p adatechnology-game-kit watch",
    "site:thumbs": "node site/capture-thumbs.mjs",
    "prepare": "git config core.hooksPath > /dev/null 2>&1 || git config core.hooksPath .githooks 2>/dev/null || true",
    "check:layers": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json packages/*/src",
    "check:layers:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json packages/*/src",
    "check:packages": "node tools/check-packages.mjs",
    "verify:push": "sh .githooks/pre-push"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "22.20.5",
    "@types/three": "0.160.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.18.0",
    "globals": "^16.0.0",
    "playwright-core": "1.58.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
