{
  "name": "@adatechnology/game-destruction-bench",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Reusable destruction test area for three.js: spawn any object, grab, carry and throw it, shoot, hit, burn, melt and take it apart with tools, and inspect every part. Knows nothing about any game.",
  "keywords": ["game", "destruction", "damage", "materials", "fracture", "fire", "three", "threejs", "devtools", "playtest"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-destruction-bench"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-destruction": "workspace:*",
    "@adatechnology/game-destruction-three": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "happy-dom": "^17.4.4"
  }
}
