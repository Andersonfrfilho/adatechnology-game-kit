{
  "name": "@adatechnology/game-devtools",
  "version": "0.1.0",
  "license": "MIT",
  "description": "In-game test tooling for three.js games: free-fly mode, position HUD, notes and marks, control panel, scenario runner and entity labels. Knows nothing about any game.",
  "keywords": [
    "three",
    "threejs",
    "game",
    "devtools",
    "debug",
    "free-fly",
    "playtest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "happy-dom": "^17.4.4",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
