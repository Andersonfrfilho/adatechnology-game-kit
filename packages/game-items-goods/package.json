{
  "name": "@adatechnology/game-items-goods",
  "version": "0.1.5",
  "license": "MIT",
  "description": "Catalog of real-world items for @adatechnology/game-items: 327 items with real size and weight, categories, places, rarities, storage, recipes, containers, house pools, depletion and spawn numbers, use effects, ammo boxes and pt-BR and en texts. Generated by tools/items-catalog from the team deliveries.",
  "keywords": [
    "game",
    "items",
    "loot",
    "catalog",
    "survival",
    "content"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-items-goods"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-items": "workspace:*"
  },
  "devDependencies": {
    "@adatechnology/game-destruction": "workspace:*",
    "@adatechnology/game-interactables": "workspace:*",
    "@adatechnology/game-weapons": "workspace:*",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
