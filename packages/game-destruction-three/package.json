{
  "name": "@adatechnology/game-destruction-three",
  "version": "0.25.0",
  "license": "MIT",
  "description": "three.js renderer for @adatechnology/game-destruction: dents, holes, char, heat glow, melting, fragments, loose pieces and pooled particles (fire, smoke, sparks, dust, shards, splinters).",
  "keywords": [
    "game",
    "destruction",
    "damage",
    "materials",
    "fracture",
    "fire",
    "three",
    "threejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-destruction-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:jolt": "PIECE_SOLVER=jolt vitest run tests/drawn-solids.test.ts tests/engine-fast-chips.test.ts tests/engine-ground-inplace.test.ts tests/engine-ground.test.ts tests/ground-rise-lift.test.ts tests/loop-mode.test.ts tests/determinism.test.ts tests/engine-remove-wakes.test.ts tests/tether-forget.test.ts tests/engine-ground-budget.test.ts"
  },
  "dependencies": {
    "@adatechnology/game-audio": "workspace:^",
    "@adatechnology/game-contracts": "workspace:^",
    "@adatechnology/game-destruction": "workspace:^",
    "@adatechnology/game-render-three": "workspace:^",
    "@adatechnology/game-shapes": "workspace:^",
    "@adatechnology/game-shapes-three": "workspace:^",
    "@adatechnology/game-vfx": "workspace:^",
    "@adatechnology/game-vfx-three": "workspace:^",
    "@adatechnology/game-physics": "workspace:^"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@adatechnology/game-terrain": "workspace:^",
    "@adatechnology/golden-tool": "workspace:^",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@adatechnology/game-physics-jolt": "workspace:^"
  }
}
