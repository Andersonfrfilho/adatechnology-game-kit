{
  "name": "@adatechnology/game-floorplan-three",
  "version": "0.8.0",
  "license": "MIT",
  "description": "three.js renderer for @adatechnology/game-floorplan: walls, doors, windows, floors, stairs, roofs, lot, furniture, lights, mirrors and cars of a plan, bound to the destruction of its structure, plus the floor navigator.",
  "keywords": [
    "game",
    "floorplan",
    "house",
    "three",
    "threejs",
    "renderer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-floorplan-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:^",
    "@adatechnology/game-destruction": "workspace:^",
    "@adatechnology/game-floorplan-interactables": "workspace:^",
    "@adatechnology/game-floorplan-structure": "workspace:^",
    "@adatechnology/game-props3d": "workspace:^",
    "@adatechnology/game-shapes-three": "workspace:^",
    "@adatechnology/game-floorplan-residential": "workspace:^"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@adatechnology/game-floorplan": "workspace:^",
    "@adatechnology/game-interactables": "workspace:^",
    "@adatechnology/game-interactables-household": "workspace:^",
    "@adatechnology/game-interactables-three": "workspace:^",
    "@adatechnology/game-floorplan-commercial": "workspace:^",
    "@adatechnology/golden-tool": "workspace:^",
    "@adatechnology/game-destruction-three": "workspace:^",
    "@adatechnology/game-vegetation": "workspace:^",
    "@adatechnology/game-vegetation-species": "workspace:^",
    "@adatechnology/game-floorplan-rural": "workspace:^",
    "@adatechnology/game-floorplan-post-apocalyptic": "workspace:^"
  }
}
