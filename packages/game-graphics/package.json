{
  "name": "@adatechnology/game-graphics",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The player's graphics settings without any engine: presets (Automatic, Low, Medium, High, Ultra), resolution scale, horde detail, shadows, view distance, FPS cap and counter, the automatic mode driven by the frame time, a short calibration on load, the choice kept in the browser, and a plain DOM settings screen.",
  "keywords": [
    "game",
    "graphics",
    "settings",
    "quality",
    "adaptive-resolution",
    "fps"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-graphics"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./screen": {
      "types": "./dist/screen.d.ts",
      "import": "./dist/screen.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "happy-dom": "^17.4.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
