{
  "name": "@adatechnology/game-fluids-three",
  "version": "0.4.2",
  "license": "MIT",
  "description": "three.js renderer for @adatechnology/game-fluids: liquid surfaces inside containers, streams with a drop at the tip, puddles that grow from a flow front, wet surfaces that reflect and dry from the edge.",
  "keywords": [
    "game",
    "fluids",
    "liquids",
    "three",
    "threejs",
    "puddles",
    "wet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-fluids-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-fluids": "workspace:*",
    "@adatechnology/game-vfx": "workspace:*",
    "@adatechnology/game-vfx-three": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
