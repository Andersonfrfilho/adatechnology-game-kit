{
  "name": "@adatechnology/game-kit-defaults",
  "version": "0.3.6",
  "license": "MIT",
  "description": "The default preset of the game kit (L5 composition): imports the content packs and returns the ready options the cores and adapters take by option, like Bevy's DefaultPlugins. A game that wants other content leaves it out.",
  "keywords": [
    "game",
    "defaults",
    "preset",
    "composition"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-kit-defaults"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/kit-worker.js",
    "./dist/kit-worker.global.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "import": "./dist/world.js"
    },
    "./kit-worker": "./dist/kit-worker.js",
    "./kit-worker.global": "./dist/kit-worker.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-audio": "workspace:^",
    "@adatechnology/game-characters-people": "workspace:^",
    "@adatechnology/game-contracts": "workspace:^",
    "@adatechnology/game-crowd": "workspace:^",
    "@adatechnology/game-destruction": "workspace:^",
    "@adatechnology/game-destruction-three": "workspace:^",
    "@adatechnology/game-floorplan-residential": "workspace:^",
    "@adatechnology/game-fluids": "workspace:^",
    "@adatechnology/game-fluids-three": "workspace:^",
    "@adatechnology/game-graphics": "workspace:^",
    "@adatechnology/game-graphics-three": "workspace:^",
    "@adatechnology/game-physics": "workspace:^",
    "@adatechnology/game-physics-jolt": "workspace:^",
    "@adatechnology/game-render-three": "workspace:^",
    "@adatechnology/game-runtime": "workspace:^",
    "@adatechnology/game-shapes": "workspace:^",
    "@adatechnology/game-terrain": "workspace:^",
    "@adatechnology/game-terrain-three": "workspace:^",
    "@adatechnology/game-urban": "workspace:^",
    "@adatechnology/game-vegetation-species": "workspace:^",
    "@adatechnology/game-vehicles-fleet": "workspace:^",
    "@adatechnology/game-vfx": "workspace:^",
    "@adatechnology/game-vfx-three": "workspace:^",
    "@adatechnology/game-workers": "workspace:^"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@adatechnology/game-stories": "workspace:^",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "happy-dom": "^17.4.4",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
