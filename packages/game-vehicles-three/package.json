{
  "name": "@adatechnology/game-vehicles-three",
  "version": "0.0.0",
  "license": "MIT",
  "description": "three.js output of the vehicles of @adatechnology/game-vehicles: a vehicle in a game frame (front on +z, centred, on the ground) at full detail or fused into six meshes (the team's Frota Leve light mode), coloured by seed, with its damageable boxes; and the vehicles test module.",
  "keywords": [
    "game",
    "vehicles",
    "three",
    "threejs",
    "low-poly",
    "lod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-vehicles-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-vehicles": "workspace:*",
    "@adatechnology/game-vehicles-driving": "workspace:*",
    "@adatechnology/game-vehicles-fleet": "workspace:*"
  },
  "devDependencies": {
    "@adatechnology/game-test-room": "workspace:*",
    "@adatechnology/game-vfx": "workspace:*",
    "@adatechnology/golden-tool": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/three": "0.128.0",
    "happy-dom": "^17.4.4",
    "three": "0.128.0",
    "three160": "npm:three@0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "three": ">=0.128.0"
  }
}
