{
  "name": "@adatechnology/game-vfx-three",
  "version": "0.3.5",
  "license": "MIT",
  "description": "three.js renderer for @adatechnology/game-vfx: the Explosion Lab's shaders (heat-ramp puffs that dissolve, streaked shrapnel, halos, shock shell and ground ring), debris with embers, blast and fire lights, scorch and crater marks that follow a dented ground patch, the screen flash overlay, and an EffectSink the test room lends to every module.",
  "keywords": [
    "three",
    "threejs",
    "game",
    "vfx",
    "explosion",
    "particles",
    "shaders"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-vfx-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:^",
    "@adatechnology/game-vfx": "workspace:^"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@adatechnology/golden-tool": "workspace:^",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "happy-dom": "^17.4.4",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
