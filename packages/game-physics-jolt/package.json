{
  "name": "@adatechnology/game-physics-jolt",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Adapter of @adatechnology/game-physics over Jolt Physics (JoltPhysics.js, single-threaded wasm-compat build): the kit's rigid-body contract with Jolt under it.",
  "keywords": [
    "game",
    "physics",
    "jolt",
    "rigid-body",
    "three",
    "threejs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-physics-jolt"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-physics": "workspace:^",
    "jolt-physics": "1.1.1"
  },
  "devDependencies": {
    "@adatechnology/game-characters": "workspace:^",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@adatechnology/game-destruction": "workspace:^"
  }
}
