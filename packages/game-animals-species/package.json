{
  "name": "@adatechnology/game-animals-species",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Content pack for @adatechnology/game-animals: 13 species (cow, horse, pig, wild boar, capybara, jaguar, dog, cat, chicken, southern lapwing, vulture, lancehead, rat) with body specs, gaits, sound ranges and the outbreak rule as data, in en and pt-BR. A game that never reads the outbreak field gets plain animals.",
  "keywords": [
    "game",
    "animals",
    "species",
    "content-pack"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-animals-species"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@adatechnology/game-animals": "workspace:*"
  }
}
