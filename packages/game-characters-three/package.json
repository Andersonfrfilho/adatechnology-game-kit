{
  "name": "@adatechnology/game-characters-three",
  "version": "0.1.3",
  "license": "MIT",
  "description": "three.js presentation for @adatechnology/game-characters: the instanced crowd body (GPU animation, LOD, baking, variants, flying limbs) and the rich bodies (the Bestiário v17 builder, survivors with accessories and hands, the animator, wounds, eyes).",
  "keywords": [
    "three",
    "threejs",
    "game",
    "characters",
    "instancing",
    "zombie",
    "procedural"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-characters-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-characters": "workspace:*",
    "@adatechnology/game-contracts": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@adatechnology/game-characters-people": "workspace:*",
    "@adatechnology/game-characters-undead": "workspace:*",
    "@adatechnology/game-test-room": "workspace:*",
    "@adatechnology/golden-tool": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "happy-dom": "^17.4.4",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
