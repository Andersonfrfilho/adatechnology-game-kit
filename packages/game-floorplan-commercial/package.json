{
  "name": "@adatechnology/game-floorplan-commercial",
  "version": "2.0.0",
  "license": "MIT",
  "description": "Commercial content pack for @adatechnology/game-floorplan: market and pharmacy templates, shop catalogue, slot libraries, commercial style and en / pt-BR names. Extends the residential pack.",
  "keywords": [
    "game",
    "floorplan",
    "commercial",
    "shop",
    "market",
    "pharmacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-floorplan-commercial"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@adatechnology/game-floorplan": "workspace:^",
    "@adatechnology/game-floorplan-residential": "workspace:^",
    "@adatechnology/game-floorplan-structure": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@adatechnology/game-floorplan": "workspace:*",
    "@adatechnology/game-floorplan-residential": "workspace:*",
    "@adatechnology/game-floorplan-structure": "workspace:*"
  }
}
