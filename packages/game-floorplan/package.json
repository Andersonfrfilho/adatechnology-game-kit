{
  "name": "@adatechnology/game-floorplan",
  "version": "0.2.2",
  "license": "MIT",
  "description": "Procedural floor plans and lots engine: rooms, walls, doors, windows, recorded slots, seeded item fill, placement rules, perimeter, gates, paths, ground cover, multi-floor stairs and a colour-harmony palette. Knows nothing about any particular furniture or game.",
  "keywords": [
    "game",
    "floorplan",
    "procedural",
    "house",
    "layout",
    "seeded",
    "engine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-floorplan"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "viewer:build": "node viewer/build-viewer.mjs"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:^"
  },
  "devDependencies": {
    "@adatechnology/golden-tool": "workspace:^",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
