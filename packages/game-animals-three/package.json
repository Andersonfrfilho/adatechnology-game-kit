{
  "name": "@adatechnology/game-animals-three",
  "version": "0.3.2",
  "license": "MIT",
  "description": "three.js drawing of the animals of @adatechnology/game-animals: a literal port of the Bichos do Vale builders (quadruped, bird, snake) and their animation, with the alive, infected and dead looks for every species, the joints and split views, and a GPU node skin for crowds.",
  "keywords": [
    "game",
    "animals",
    "three",
    "threejs",
    "quadruped",
    "bird",
    "snake"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-animals-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@adatechnology/game-animals-species": "workspace:*",
    "@adatechnology/game-characters-undead": "workspace:*",
    "@adatechnology/game-test-room": "workspace:*",
    "@adatechnology/golden-tool": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "happy-dom": "^17.4.4",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@adatechnology/game-animals": "workspace:*",
    "@adatechnology/game-audio": "workspace:*",
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-props3d": "workspace:*",
    "@adatechnology/game-shapes-three": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  }
}
