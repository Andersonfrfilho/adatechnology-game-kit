{
  "name": "@adatechnology/game-characters",
  "version": "0.2.5",
  "license": "MIT",
  "description": "Engine-agnostic living bodies for games: body proportions, rig, an 11-kind segment tree with 6 crowd regions, and a damage model (protection, penetration, severity, dismemberment, death, bleeding) as a DestructibleImpl. Deterministic. Knows nothing about any game.",
  "keywords": [
    "game",
    "characters",
    "body",
    "damage",
    "dismemberment",
    "penetration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-characters"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:*"
  },
  "devDependencies": {
    "@adatechnology/game-destruction": "workspace:*",
    "@adatechnology/game-weapons": "workspace:*",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
