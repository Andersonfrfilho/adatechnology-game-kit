    "@dimforge/rapier3d-simd-compat": "0.21.0",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@adatechnology/game-destruction": "workspace:^",
    "@adatechnology/game-contracts": "workspace:^"
  }
}
