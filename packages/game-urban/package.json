{
  "name": "@adatechnology/game-urban",
  "version": "0.2.5",
  "license": "MIT",
  "description": "The urban pattern as data, with no three.js: the five street poles with a light budget, roads, sidewalks and street grids, filled blocks of city buildings and the props of a street (fences, tents, trees, containers, watch towers, sandbags, labels, wires), as parts on the silhouette vocabulary of game-floorplan. Every catalogue is a registry and every number an option.",
  "keywords": [
    "game",
    "urban",
    "city",
    "streets",
    "street-lights",
    "procedural",
    "seeded"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-urban"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-floorplan": "workspace:*",
    "@adatechnology/game-vegetation-species": "workspace:*",
    "@adatechnology/game-vehicles-fleet": "workspace:*"
  },
  "devDependencies": {
    "@adatechnology/game-floorplan-commercial": "workspace:*",
    "@adatechnology/game-floorplan-residential": "workspace:*",
    "@adatechnology/game-floorplan-structure": "workspace:*",
    "@adatechnology/golden-tool": "workspace:*",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
