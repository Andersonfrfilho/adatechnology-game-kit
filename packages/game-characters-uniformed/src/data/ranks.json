  "rule": {
    "commander": {
      "choose": "highest-rank-alive",
      "minimumCourageAndLoyalty": 100
    },
    "disobeyBelowOpinion": -20,
    "onDisobey": [
      "disobey",
      "desert",
      "mutiny"
    ],
    "text": {
      "pt-BR": "No jogo, patente decide quem manda quando o líder cai (maior patente viva com coragem + lealdade ≥ 100) e o que um soldado obedece. Ordem de patente maior vence opinião, a menos que a opinião do soldado pelo superior esteja abaixo de −20: aí ele desobedece, deserta ou se amotina."
    }
  }
