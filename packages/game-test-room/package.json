{
  "name": "@adatechnology/game-test-room",
  "version": "0.10.0",
  "license": "MIT",
  "description": "Reusable test room for three.js: any module loads its objects, then the player grabs, carries and throws them, shoots them with the weapons of @adatechnology/game-weapons, hits, burns, melts and takes them apart, with a behaviour log that can be exported and scripted checks. Knows nothing about any game.",
  "keywords": [
    "game",
    "test-room",
    "destruction",
    "weapons",
    "three",
    "threejs",
    "devtools",
    "playtest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-test-room"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-audio": "workspace:*",
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-destruction": "workspace:*",
    "@adatechnology/game-destruction-three": "workspace:*",
    "@adatechnology/game-fluids": "workspace:*",
    "@adatechnology/game-fluids-three": "workspace:*",
    "@adatechnology/game-vfx": "workspace:*",
    "@adatechnology/game-vfx-three": "workspace:*",
    "@adatechnology/game-weapons": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "happy-dom": "^17.4.4"
  }
}
