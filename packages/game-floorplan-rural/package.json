{
  "name": "@adatechnology/game-floorplan-rural",
  "version": "4.0.0",
  "license": "MIT",
  "description": "Rural content pack for @adatechnology/game-floorplan: wood frame house, A-frame chalet, log cabin, shack and campsite, with the rural style, slot libraries, items and en / pt-BR names. Region data under br.",
  "keywords": [
    "game",
    "floorplan",
    "rural",
    "cabin",
    "shack",
    "campsite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-floorplan-rural"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@adatechnology/game-floorplan": "workspace:^",
    "@adatechnology/game-floorplan-residential": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@adatechnology/game-floorplan": "workspace:*",
    "@adatechnology/game-floorplan-residential": "workspace:*"
  }
}
