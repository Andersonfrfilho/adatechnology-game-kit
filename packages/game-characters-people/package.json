{
  "name": "@adatechnology/game-characters-people",
  "version": "0.3.3",
  "license": "MIT",
  "description": "Content pack for @adatechnology/game-characters: 12 generic professions as character presets (nurse, police officer, firefighter, mechanic, builder, cook, sport shooter, farmer, electrician, courier, teacher, unemployed), age presets, appearance pools and the ids of about 100 accessories, with en and pt-BR names. Named people stay in the game.",
  "keywords": [
    "game",
    "characters",
    "people",
    "professions",
    "content-pack"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-characters-people"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-characters": "workspace:*"
  },
  "devDependencies": {
    "@adatechnology/game-player": "workspace:*",
    "@types/node": "^22.10.7",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
