{
  "name": "@adatechnology/game-vehicles-fleet",
  "version": "4.0.0",
  "license": "MIT",
  "description": "Fleet content pack for @adatechnology/game-vehicles: 69 procedural vehicles (motorcycles, cars, SUVs, pickups, vans, trucks, buses, tractors, military, boats, planes and helicopters), fuels, groups, generic crash scenarios and en / pt-BR texts.",
  "keywords": [
    "three",
    "threejs",
    "game",
    "vehicles",
    "fleet",
    "cars",
    "procedural"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-vehicles-fleet"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@adatechnology/game-vehicles": "workspace:^"
  },
  "devDependencies": {
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-vehicles": "workspace:*",
    "@adatechnology/golden-tool": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
