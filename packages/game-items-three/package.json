{
  "name": "@adatechnology/game-items-three",
  "version": "0.0.0",
  "license": "MIT",
  "description": "three.js presentation for @adatechnology/game-items: the 24 models of the Itens do Vale Cinzento showcase at real size, simple shapes at real size for every other item, wear (new, used, spoiled) on the materials, merge by material, LOD and the draw budgets of the team.",
  "keywords": [
    "three",
    "threejs",
    "game",
    "items",
    "props",
    "procedural",
    "lod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersonfrfilho/adatechnology-game-kit.git",
    "directory": "packages/game-items-three"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "jsdelivr": "dist/index.global.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global": "./dist/index.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adatechnology/game-contracts": "workspace:*",
    "@adatechnology/game-interactables": "workspace:*",
    "@adatechnology/game-items": "workspace:*",
    "@adatechnology/game-props3d": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@adatechnology/game-items-goods": "workspace:*",
    "@adatechnology/game-test-room": "workspace:*",
    "@adatechnology/golden-tool": "workspace:*",
    "@types/node": "^22.10.7",
    "@types/three": "^0.160.0",
    "happy-dom": "^17.4.4",
    "three": "^0.160.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
