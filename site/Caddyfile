:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# a page (/, /area, /area/, *.html) revalidates by ETag, or a deploy stays hidden behind the day-long asset cache
	@asset {
		path_regexp \.[A-Za-z0-9]+$
		not path *.html
	}
	header @asset Cache-Control "public, max-age=86400"
	@page {
		not {
			path_regexp \.[A-Za-z0-9]+$
			not path *.html
		}
	}
	header @page Cache-Control "no-cache"

	try_files {path} {path}/index.html
	file_server

	log {
		output stdout
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
