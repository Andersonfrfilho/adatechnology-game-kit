:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	@html {
		path / *.html
	}
	header @html Cache-Control "public, max-age=300"
	@other not path / *.html
	header @other Cache-Control "public, max-age=86400"

	try_files {path} {path}/index.html
	file_server

	log {
		output stdout
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
