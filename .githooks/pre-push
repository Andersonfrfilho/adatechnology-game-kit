#!/bin/sh
# Checks a push on this machine before it leaves, in two halves, each under a lock shared by every worktree of this repository, so several sessions
# pushing at once queue instead of sharing the cores (four pushes at once took 20 to 40 min each; one at a time each takes a few):
#   1. CPU (tools/pre-push/checks.mjs, lock cpu.lock): build with a cache by content shared by every worktree (a package equal to one already built
#      anywhere is copied, not built), lint of the changed files, and typecheck and tests of the packages the branch changed, in parallel. CI builds,
#      typechecks, lints and tests every package on the pull request, and the merge waits for it.
#   2. GPU (tools/gpu/browser-checks.mjs, lock gpu.lock, the one the daily run takes): the browser suites of the example areas the branch changes, on
#      the charger only (CLAUDE.md, "Testes de GPU e navegador"). While one push is here, the next one is already in its CPU half.
# Skip once with `git push --no-verify`. PRE_PUSH_ALL=1 checks every package and every area; PRE_PUSH_DEPENDENTS=1 also typechecks and tests the
# packages that depend on the changed ones; PRE_PUSH_BROWSER=0 skips the browser suites; PRE_PUSH_NO_LOCK=1 does not queue.
set -e
git fetch -q origin main 2>/dev/null || true

locks="${XDG_CACHE_HOME:-$HOME/.cache}/adatechnology-game-kit"
mkdir -p "$locks"

# Runs a command holding a lock; when another push holds it, says so and waits. Without flock (not Linux) it just runs.
locked() {
  lock="$locks/$1"; shift
  if [ -n "$PRE_PUSH_NO_LOCK" ] || ! command -v flock > /dev/null 2>&1; then "$@"; return; fi
  status=0
  flock -n -E 75 "$lock" "$@" || status=$?
  if [ "$status" -eq 75 ]; then
    echo "pre-push: waiting for another push to finish its $(basename "$lock" .lock) checks..."
    waited=$(date +%s)
    status=0
    flock "$lock" sh -c 'echo "pre-push: got the lock after $(( $(date +%s) - $0 ))s"; exec "$@"' "$waited" "$@" || status=$?
  fi
  return "$status"
}

locked cpu.lock node tools/pre-push/checks.mjs
locked gpu.lock node tools/gpu/browser-checks.mjs
