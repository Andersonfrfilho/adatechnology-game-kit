#!/bin/sh
# Checks a push on this machine before it leaves, under a lock shared by every worktree of this repository, so several sessions
# pushing at once queue instead of sharing the cores (four pushes at once took 20 to 40 min each; one at a time each takes a few):
# tools/pre-push/checks.mjs, under cpu.lock: build with a cache by content shared by every worktree (a package equal to one already built
#      anywhere is copied, not built), lint of the changed files, and typecheck and tests of the packages the branch changed, in parallel. CI builds,
#      typechecks, lints and tests every package on the pull request, and the merge waits for it.
# The browser and GPU suites never run here (owner, 2026-11-08): they run once a day, at dawn, on main (tools/gpu/nightly-gpu.mjs, CLAUDE.md
# section 9). To run them for a branch by hand: node tools/gpu/browser-checks.mjs.
# Skip once with `git push --no-verify`. PRE_PUSH_ALL=1 checks every package and every area; PRE_PUSH_DEPENDENTS=1 also typechecks and tests the
# packages that depend on the changed ones; PRE_PUSH_NO_LOCK=1 does not queue.
set -e
git fetch -q origin main 2>/dev/null || true

locks="${XDG_CACHE_HOME:-$HOME/.cache}/adatechnology-game-kit"
mkdir -p "$locks"

# Runs a command holding a lock; when another push holds it, says so and waits. Without flock (not Linux) it just runs.
locked() {
  lock="$locks/$1"; shift
  if [ -n "$PRE_PUSH_NO_LOCK" ] || ! command -v flock > /dev/null 2>&1; then "$@"; return; fi
  status=0
  flock -n -E 75 "$lock" "$@" || status=$?
  if [ "$status" -eq 75 ]; then
    echo "pre-push: waiting for another push to finish its $(basename "$lock" .lock) checks..."
    waited=$(date +%s)
    status=0
    flock "$lock" sh -c 'echo "pre-push: got the lock after $(( $(date +%s) - $0 ))s"; exec "$@"' "$waited" "$@" || status=$?
  fi
  return "$status"
}

# git opens the connection to GitHub before this hook runs, and a long wait here (the queue) lets it drop ("error 141"). So
# the checks can run before the push: `pnpm verify:push` runs this same script with no push, and records the commit it passed for; the push of
# that same tree, on the same origin/main, then skips straight to sending.
tree=$(git rev-parse 'HEAD^{tree}')
base=$(git merge-base HEAD origin/main 2>/dev/null || echo none)
stamp="$locks/pre-push/verified/$tree-$base"
if [ -z "$PRE_PUSH_ALL" ] && [ -z "$(git status --porcelain --untracked-files=no)" ] && [ -f "$stamp" ]; then
  echo "pre-push: this commit already passed pnpm verify:push on the same origin/main, pushing"
  exit 0
fi

locked cpu.lock node tools/pre-push/checks.mjs
mkdir -p "$(dirname "$stamp")" && touch "$stamp"
